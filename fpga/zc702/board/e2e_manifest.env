# e2e_manifest.env -- accounted identity for the DEFAULT native-GEM0 (JTAG-free)
# regression. Each digest is an md5 of the exact artifact the board loads. The
# gate/cap roots are NOT here -- they are nm-derived per image into
# mini_domains.env (deployed beside the hex, sourced by boot_gem_dual_smp.sh),
# so they can never go stale against the image. A mismatch is a fail-closed
# RESULT FAIL. Override any single entry via the environment.

# Native-GEM DUAL-CORE SMP telnet guest (LNP64_GEM_PUMP + LNP64_SMP + 2 rump
# vCPUs), fixed-clang. Both fabric cores run one kernel; drives PS GEM0 directly
# over the GP aperture; no JTAG ring, no host bridge.
E2E_EXPECT_GUEST_TEXT=63ea0a6ec028afc0c8ba119b8d62f666
E2E_EXPECT_GUEST_DATA=a11e0b34f793cc02c9a2e70fc8f12606
E2E_EXPECT_GUEST_TEXT_BIN=1c9f8d7c4a531952c2afe4cbc8c0bbca
E2E_EXPECT_GUEST_DATA_BIN=2158e16553eed8f349be0d3262f4c4e4

# Unchanged accounted bitstream (the GP aperture is already in it) + debug map.
E2E_EXPECT_BIT=e66d2c2221aa6e8dd5df07c55f77c079
E2E_EXPECT_DEBUGMAP=c8994a2af81d368cf4ed60e1c4ef7043

E2E_PING_TARGET=10.106.0.2
E2E_ECHO_TOKEN=e2e-ok-over-gem
