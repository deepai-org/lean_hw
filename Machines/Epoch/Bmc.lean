/-- Kernel re-check of the depth-2 BMC certificate. -/
theorem bmc2_cert_ok :
    Check.check (bmcCnf epochMod safeP 2) bmc2Cert = true := by decide

/-! ## The results -/

/-- Kernel re-check of the k-induction *base* certificate. -/
theorem base_cert_ok :
    Check.check (bmcCnf epochMod safeP 0) baseCert = true := by decide

/-- Kernel re-check of the k-induction *step* certificate. -/
theorem step_cert_ok :
    Check.check (Loom.Dp.KInduction.kindStepCnf epochMod safeP 1) stepCert = true := by decide

/-- **The step obligation, over the whole state space.** For *any* netlist
state `s0` — reachable or not — if the safety conjunction holds at `s0` it
holds one cycle later. This is `safeP` proved 1-inductive over all `2³⁹`
states of the epoch engine, and it is the model checker's strongest
statement. -/
theorem safeP_inductive :
    ∀ s0, (∀ i, i < 1 → safeP.eval (epochMod.run i s0) = 1#1) →
      safeP.eval (epochMod.run 1 s0) = 1#1 :=
  Loom.Dp.KInduction.kind_step_sound epochMod safeP 1 epoch_nodup stepCert step_cert_ok

/-- **The unbounded invariant.** Base + step: the epoch engine's safety
conjunction holds at *every* cycle of the run from reset. -/
theorem safeP_invariant : ∀ n, safeP.eval (epochMod.run n epochMod.reset) = 1#1 :=
  Loom.Dp.KInduction.kinduction_sound epochMod safeP 1 (by omega) epoch_nodup
    baseCert base_cert_ok stepCert step_cert_ok

#print axioms safeP_inductive
#print axioms safeP_invariant

/-- **The bounded result.** The safety conjunction holds at every step of
the first three cycles out of reset — the classic BMC statement, kept
because it is the one the `EPOCH_SPEC.md` plan names and because it is
proved by a *different* engine query than the k-induction pair above. -/
theorem safeP_bmc2 : ∀ j, j ≤ 2 → safeP.eval (epochMod.run j epochMod.reset) = 1#1 :=
  bmc_sound epochMod safeP 2 epoch_nodup bmc2Cert bmc2_cert_ok

#print axioms safeP_bmc2

end Machines.Epoch.Mc
