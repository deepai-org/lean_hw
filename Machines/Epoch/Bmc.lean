import Loom
import Machines.Epoch.Protocol

/-!
# The epoch protocol's model-checking leg (independent of the kernel proofs)

`Machines/Epoch/Protocol.lean` proves T-E1 … T-E7 about the *protocol*.
This file is the second, deliberately independent leg `EPOCH_SPEC.md` asks
for: the same safety statements re-established over a **bit-level netlist**
by Loom's decision procedures (`Loom/Dp/Bmc.lean`, `Loom/Dp/KInduction.lean`)
with LRAT certificates that the Lean kernel re-checks.

**The model.** `design` is a small closed instance of the protocol at the
bounds `EPOCH_SPEC.md` names: `N = 2` cells, `K = 2` referent volumes,
epoch width 3 (saturation value 7). Home epochs, poison and dead bits, the
four per-volume replicas, the one in-flight bump with its two ack bits, and
a class-0 check latched into `ok0` are all registers. The design is closed:
an 8-bit LFSR drives the op stream (`bump` / `ack` / `bumpReturn` / `use`),
the cell, the volume, the policy, the presented epoch and the rights bit —
so `Module.run` is a real, non-trivial interleaving of the protocol's
transitions rather than an idle machine.

**What this leg can and cannot establish.** `Loom.Dp.Cnf.blast`
over-approximates `add`/`eq`/`ult` as *free* variables (see `Cnf.lean`), so
any property whose truth depends on epoch arithmetic or on the value of a
comparator is invisible to this engine. What survives is exactly the
Boolean/mux structure of the transition relation — and that is where the
epoch protocol's safety content lives:

| property | §3 sentence | protocol twin |
|---|---|---|
| `deadSticky i` | "saturation is permanent death" | T-E2 |
| `epochFrozen i` | "the counter never rolls to a live value" | T-E2 |
| `poisonSticky i` | "mark the cell so future references fail" | T-E3 |
| `retNeedsAcks` | "returns only after the invalidation acknowledgement" | T-E5 |
| `ackNeedsPending` | acks exist only inside a bump's referent span | T-E1's premise |
| `okNeedsLive` | precedence: poison and death outrank success | T-E4 |

Every one of these is a *tautology of the netlist's mux trees*, which is
why the certificates survive the arithmetic abstraction — and why the
`decide` re-check is cheap. The bound on the result is the honest one:
`bmc_sound` yields the property at every step `j ≤ k` of the run from
reset; `kinduction_sound` lifts it to *every* step, and its step
certificate (`kind_step_sound`) is discharged over an unconstrained start
state, i.e. over the whole `2³⁹`-state space of the netlist, reachable or
not.

**Build cost.** The two k-induction certificates re-check in ≈ 90 s; the
depth-2 BMC certificate (4092 clauses, 1130 RUP steps) dominates at ≈ 9 min,
so a *cold* build of this module is ≈ 10 min. It is incremental thereafter.
-/

namespace Machines.Epoch.Mc

open Loom.Hw

/-! ## The netlist: a 2-cell, 2-volume, 3-bit-epoch epoch engine -/

private def bit (n : String) : Expr 1 := Expr.reg 1 n
private def w3 (n : String) : Expr 3 := Expr.reg 3 n
private def L : Expr 8 := Expr.reg 8 "lfsr"

/-- LFSR feedback (taps 7/5/4/3) — the op-stream driver. -/
private def fb : Expr 1 :=
  Expr.xor (Expr.xor (Expr.slice L 7 1) (Expr.slice L 5 1))
           (Expr.xor (Expr.slice L 4 1) (Expr.slice L 3 1))

private def lfsrNext : Expr 8 :=
  Expr.or (Expr.shl L (Expr.lit (1 : BitVec 8))) (Expr.zext fb 8)

private def opF : Expr 2 := Expr.slice L 0 2
private def isBump : Expr 1 := Expr.eq opF (Expr.lit (0 : BitVec 2))
private def isAck : Expr 1 := Expr.eq opF (Expr.lit (1 : BitVec 2))
private def isRet : Expr 1 := Expr.eq opF (Expr.lit (2 : BitVec 2))
private def isUse : Expr 1 := Expr.eq opF (Expr.lit (3 : BitVec 2))
private def cellSel : Expr 1 := Expr.slice L 2 1
private def volSel : Expr 1 := Expr.slice L 3 1
private def policy : Expr 1 := Expr.slice L 4 1
private def reqEp : Expr 3 := Expr.slice L 5 3
private def rights : Expr 1 := Expr.slice L 6 1

private def pv : Expr 1 := bit "pv"
private def pc : Expr 1 := bit "pc"
private def pt : Expr 3 := w3 "pt"
private def a0 : Expr 1 := bit "a0"
private def a1 : Expr 1 := bit "a1"

/-- A bump may issue only when no broadcast is in flight (v1's
one-in-flight rule). -/
private def bumpEn : Expr 1 := Expr.and isBump (Expr.not pv)
private def sel (i : Nat) : Expr 1 :=
  Expr.and bumpEn (if i = 0 then Expr.not cellSel else cellSel)
private def ackEn (k : Nat) : Expr 1 :=
  Expr.and (Expr.and isAck pv) (if k = 0 then Expr.not volSel else volSel)
/-- §3's return guarantee, in one gate: the bump returns only when *every*
volume of the referent span has acknowledged. -/
private def retEn : Expr 1 := Expr.and (Expr.and isRet pv) (Expr.and a0 a1)

private def eR (i : Nat) : Expr 3 := w3 (if i = 0 then "e0" else "e1")
private def dR (i : Nat) : Expr 1 := bit (if i = 0 then "d0" else "d1")
private def pR (i : Nat) : Expr 1 := bit (if i = 0 then "p0" else "p1")

/-- The saturating increment: at `7` the counter stands still. -/
private def satE (i : Nat) : Expr 3 :=
  Expr.mux (Expr.eq (eR i) (Expr.lit (7 : BitVec 3))) (eR i)
    (Expr.add (eR i) (Expr.lit (1 : BitVec 3)))

/-- A dead cell's counter is frozen: death outranks the increment. -/
private def eNext (i : Nat) : Expr 3 :=
  Expr.mux (dR i) (eR i) (Expr.mux (sel i) (satE i) (eR i))
private def dNext (i : Nat) : Expr 1 :=
  Expr.mux (sel i) (Expr.or (dR i) (Expr.eq (satE i) (Expr.lit (7 : BitVec 3)))) (dR i)
private def pNext (i : Nat) : Expr 1 :=
  Expr.mux (sel i) (Expr.or (pR i) policy) (pR i)

private def targetE : Expr 3 := Expr.mux cellSel (eNext 1) (eNext 0)

/-- Volume `k`'s replica of cell `i` adopts the broadcast epoch on ack. -/
private def replName (k i : Nat) : String :=
  if k = 0 then (if i = 0 then "r00" else "r01") else (if i = 0 then "r10" else "r11")
private def replNext (k i : Nat) : Expr 3 :=
  Expr.mux (Expr.and (ackEn k) (if i = 0 then Expr.not pc else pc)) pt (w3 (replName k i))

/-- The class-0 check at volume 0 on cell 0: one local compare, plus §3's
precedence (poison and death gate success ahead of the compare). -/
private def ok0Next : Expr 1 :=
  Expr.and (Expr.and (Expr.and isUse (Expr.and (Expr.not cellSel) (Expr.not volSel)))
             (Expr.and (Expr.not (pR 0)) (Expr.not (dR 0))))
    (Expr.and (Expr.eq (w3 "r00") reqEp) rights)

private def wr1 (n : String) (e : Expr 1) : Act := Act.write 1 n e
private def wr8 (n : String) (e : Expr 8) : Act := Act.write 8 n e
private def wr3 (n : String) (e : Expr 3) : Act := Act.write 3 n e

/-- The register list, named so `regs` and D39a's mandatory `outputs`
provably denote the same thing. -/
def bmcRegs : List Loom.Hw.RegDecl :=
    [ ⟨"lfsr", 8, (0xB5 : BitVec 8)⟩,
      ⟨"e0", 3, (1 : BitVec 3)⟩, ⟨"e1", 3, (1 : BitVec 3)⟩,
      ⟨"d0", 1, (0 : BitVec 1)⟩, ⟨"d1", 1, (0 : BitVec 1)⟩,
      ⟨"p0", 1, (0 : BitVec 1)⟩, ⟨"p1", 1, (0 : BitVec 1)⟩,
      ⟨"r00", 3, (1 : BitVec 3)⟩, ⟨"r01", 3, (1 : BitVec 3)⟩,
      ⟨"r10", 3, (1 : BitVec 3)⟩, ⟨"r11", 3, (1 : BitVec 3)⟩,
      ⟨"pv", 1, (0 : BitVec 1)⟩, ⟨"pc", 1, (0 : BitVec 1)⟩,
      ⟨"pt", 3, (0 : BitVec 3)⟩,
      ⟨"a0", 1, (0 : BitVec 1)⟩, ⟨"a1", 1, (0 : BitVec 1)⟩,
      ⟨"ret", 1, (0 : BitVec 1)⟩, ⟨"ok0", 1, (0 : BitVec 1)⟩ ]

/-- The design. One rule; every register's next value in one place. -/
def design : Design where
  name := "epochmc"
  mems := []
  regs := bmcRegs
  -- D39a: outputs are mandatory and explicit, like inputs.
  outputs := bmcRegs.map (·.name)
  rules :=
    [ { name := "epoch"
        body :=
          Act.seq (wr8 "lfsr" lfsrNext) <|
          Act.seq (wr3 "e0" (eNext 0)) <|
          Act.seq (wr3 "e1" (eNext 1)) <|
          Act.seq (wr1 "d0" (dNext 0)) <|
          Act.seq (wr1 "d1" (dNext 1)) <|
          Act.seq (wr1 "p0" (pNext 0)) <|
          Act.seq (wr1 "p1" (pNext 1)) <|
          Act.seq (wr3 "r00" (replNext 0 0)) <|
          Act.seq (wr3 "r01" (replNext 0 1)) <|
          Act.seq (wr3 "r10" (replNext 1 0)) <|
          Act.seq (wr3 "r11" (replNext 1 1)) <|
          Act.seq (wr1 "pv" (Expr.mux bumpEn (Expr.lit (1 : BitVec 1))
                    (Expr.mux retEn (Expr.lit (0 : BitVec 1)) pv))) <|
          Act.seq (wr1 "pc" (Expr.mux bumpEn cellSel pc)) <|
          Act.seq (wr3 "pt" (Expr.mux bumpEn targetE pt)) <|
          Act.seq (wr1 "a0" (Expr.mux bumpEn (Expr.lit (0 : BitVec 1))
                    (Expr.mux (ackEn 0) (Expr.lit (1 : BitVec 1)) a0))) <|
          Act.seq (wr1 "a1" (Expr.mux bumpEn (Expr.lit (0 : BitVec 1))
                    (Expr.mux (ackEn 1) (Expr.lit (1 : BitVec 1)) a1))) <|
          Act.seq (wr1 "ret" retEn) (wr1 "ok0" ok0Next) } ]

end Machines.Epoch.Mc

namespace Machines.Epoch.Mc

open Loom.Emit.MicroVerilog Loom.Dp.Bmc Loom.Dp.Cnf Loom.Dp.Cert Std.Sat

set_option maxRecDepth 40000
set_option maxHeartbeats 12000000

/-- The compiled netlist. -/
def epochMod : Module := Loom.Hw.Compile.compile design

/-- The compiler's next-value expression for a register (the Acc8-BMC
idiom): properties are stated over `reg` reads and these. -/
def nextOf (nm : String) (w : Nat) : Expr w :=
  match epochMod.regs.find? (fun r => r.name == nm) with
  | some r => if h : r.width = w then h ▸ r.next else .lit 0#w
  | none => .lit 0#w

private def imp (a b : Expr 1) : Expr 1 := .or (.not a) b
private def R1 (n : String) : Expr 1 := .reg 1 n
private def R3 (n : String) : Expr 3 := .reg 3 n

/-- Bitwise equality of two 3-bit expressions, as an `Expr 1`. -/
private def eq3 (a b : Expr 3) : Expr 1 :=
  let x : Expr 3 := .xor a b
  .and (.and (.not (.slice x 0 1)) (.not (.slice x 1 1))) (.not (.slice x 2 1))

/-- §3 "saturation is permanent death": the `dead` bit never clears. -/
def deadSticky (n : String) : Expr 1 := imp (R1 n) (nextOf n 1)

/-- §3 "the counter never rolls to a live value": a dead cell's epoch
register is frozen. -/
def epochFrozen (d e : String) : Expr 1 := imp (R1 d) (eq3 (nextOf e 3) (R3 e))

/-- §3 `poison`: "future references, not just stale ones" — the mark is
never cleared. -/
def poisonSticky (n : String) : Expr 1 := imp (R1 n) (nextOf n 1)

/-- §3's **return guarantee**: the bump-return only fires when the whole
referent span has acknowledged. The netlist twin of T-E5. -/
def retNeedsAcks : Expr 1 := imp (nextOf "ret" 1) (.and (R1 "a0") (R1 "a1"))

/-- An ack bit only rises inside a bump's broadcast window. -/
def ackNeedsPending (n : String) : Expr 1 :=
  imp (nextOf n 1) (.or (R1 n) (R1 "pv"))

/-- §3's precedence: poison and death outrank success, so a check can only
succeed against a live, unpoisoned cell. The netlist twin of T-E4/T-E2. -/
def okNeedsLive : Expr 1 :=
  imp (nextOf "ok0" 1) (.and (.not (R1 "d0")) (.not (R1 "p0")))

/-- The whole safety conjunction, checked as one property. -/
def safeP : Expr 1 :=
  .and
    (.and (.and (deadSticky "d0") (deadSticky "d1"))
          (.and (poisonSticky "p0") (poisonSticky "p1")))
    (.and
      (.and (epochFrozen "d0" "e0") (epochFrozen "d1" "e1"))
      (.and (.and retNeedsAcks (ackNeedsPending "a0"))
            (.and (ackNeedsPending "a1") okNeedsLive)))

/-- The register names of the compiled netlist are distinct (the BMC
soundness discipline). -/
theorem epoch_nodup : (epochMod.regs.map (·.name)).Nodup := by decide

